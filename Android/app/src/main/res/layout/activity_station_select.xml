<?xml version="1.0" encoding="utf-8"?>
<!-- Station Select: Consistent toolbar + enhanced empty state -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/solar_bg"
    tools:context=".prosumer.StationSelectActivity">

    <!-- ═══ TOOLBAR ═══ -->
    <LinearLayout
        android:id="@+id/header_bar_stations"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/solar_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_back_stations"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tv_stations_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Charging Stations"
            android:textColor="@color/solar_slate_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_view_map_stations"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="View Stations on Map"
            android:src="@drawable/ic_map"
            app:tint="@color/solar_green_primary" />

        <ImageButton
            android:id="@+id/btn_header_logout_stations"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_logout"
            android:contentDescription="Log Out"
            android:src="@drawable/ic_logout"
            app:tint="@color/solar_status_cancelled" />
    </LinearLayout>

    <!-- Toolbar bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/solar_border" />

    <!-- ═══ CONTENT AREA ═══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_station_select"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_stations_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Choose an active microgrid station to reserve energy trading slots"
            android:textColor="@color/solar_slate_body"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_view_stations_map"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/solar_border"
            app:cardBackgroundColor="@color/solar_surface"
            app:layout_constraintTop_toBottomOf="@+id/tv_stations_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_map"
                    app:tint="@color/solar_green_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explore Stations on Map"
                        android:textColor="@color/solar_slate_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View geographic locations, distances &amp; battery hubs"
                        android:textColor="@color/solar_slate_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/solar_slate_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_stations"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_view_stations_map">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Enhanced Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_stations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/card_view_stations_map"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_station"
                app:tint="@color/solar_slate_subtle"
                android:alpha="0.5"
                android:contentDescription="No stations" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No stations available"
                android:textColor="@color/solar_slate_body"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_stations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Active charging hubs will appear here"
                android:textColor="@color/solar_slate_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_stations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/solar_green_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stations_subtitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
