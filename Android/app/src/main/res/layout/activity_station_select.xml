<?xml version="1.0" encoding="utf-8"?>
<!-- Station Select: Consistent toolbar + enhanced empty state -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/solar_bg"
    tools:context=".prosumer.StationSelectActivity">

    <!-- ═══ TOOLBAR ═══ -->
    <LinearLayout
        android:id="@+id/header_bar_stations"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/solar_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_back_stations"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tv_stations_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Charging Stations"
            android:textColor="@color/solar_slate_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_header_logout_stations"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_logout"
            android:contentDescription="Log Out"
            android:src="@drawable/ic_logout"
            app:tint="@color/solar_status_cancelled" />
    </LinearLayout>

    <!-- Toolbar bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/solar_border" />

    <!-- ═══ CONTENT AREA ═══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_station_select"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_stations_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Choose an active microgrid station to reserve 30-minute solar power slots"
            android:textColor="@color/solar_slate_body"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_stations"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stations_subtitle" />

        <!-- Enhanced Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_stations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stations_subtitle">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_station"
                app:tint="@color/solar_slate_subtle"
                android:alpha="0.5"
                android:contentDescription="No stations" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No stations available"
                android:textColor="@color/solar_slate_body"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_stations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Active charging hubs will appear here"
                android:textColor="@color/solar_slate_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_stations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/solar_green_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stations_subtitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
