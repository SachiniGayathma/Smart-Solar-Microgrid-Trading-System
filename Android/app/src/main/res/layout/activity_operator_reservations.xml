<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="View all bookings"
        android:textColor="@color/solar_slate_dark"
        android:textSize="@dimen/title_text"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_reservation_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/solar_surface"
        android:hint="Search NIC, station, or booking id"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="@color/solar_slate_dark"
        android:textColorHint="@color/solar_slate_muted" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_operator_filter"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="All"
                android:textAllCaps="false"
                android:textColor="@color/operator_filter_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_filter_pending"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_operator_filter"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="Pending"
                android:textAllCaps="false"
                android:textColor="@color/operator_filter_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_filter_approved"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_operator_filter"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="Approved"
                android:textAllCaps="false"
                android:textColor="@color/operator_filter_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_filter_completed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_operator_filter"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="Completed"
                android:textAllCaps="false"
                android:textColor="@color/operator_filter_text"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_reservation_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="No reservations yet."
        android:textColor="@color/solar_slate_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_operator_reservations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
