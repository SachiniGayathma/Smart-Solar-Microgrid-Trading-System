<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/solar_bg"
    tools:context=".prosumer.RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <ImageButton
            android:id="@+id/btn_back_register"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="Back to Sign In"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Solar Microgrid Branding Badge Container -->
        <FrameLayout
            android:id="@+id/frame_register_logo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_logo_badge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_register_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_solar_bolt"
                app:tint="@color/solar_green_primary"
                android:contentDescription="Smart Solar Logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_brand_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="SMART SOLAR MICROGRID"
            android:textColor="@color/solar_green_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frame_register_logo" />

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tv_register_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Prosumer Registration"
            android:textColor="@color/solar_slate_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_brand_badge" />

        <TextView
            android:id="@+id/tv_register_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Join the clean energy trading network. Submit your details for administrative verification."
            android:textAlignment="center"
            android:textColor="@color/solar_slate_body"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_register_title" />

        <!-- Form Card Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_register_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/solar_surface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_register_subtitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Section: Personal Details -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="PERSONAL INFORMATION"
                    android:textColor="@color/solar_slate_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <!-- NIC Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_nic"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="NIC (National Identity Card)"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/solar_green_primary"
                    app:hintTextColor="@color/solar_green_primary"
                    app:startIconDrawable="@drawable/ic_badge_nic"
                    app:startIconTint="@color/solar_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_nic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Full Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Full Name"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/solar_green_primary"
                    app:hintTextColor="@color/solar_green_primary"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/solar_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section: Contact Details -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="CONTACT INFORMATION"
                    android:textColor="@color/solar_slate_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_email"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email Address"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/solar_green_primary"
                    app:hintTextColor="@color/solar_green_primary"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/solar_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_phone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Phone Number (e.g. 0771234567)"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/solar_green_primary"
                    app:hintTextColor="@color/solar_green_primary"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/solar_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Section: Security -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="ACCOUNT SECURITY"
                    android:textColor="@color/solar_slate_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <!-- Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_register_password"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password (min. 6 characters)"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/solar_green_primary"
                    app:hintTextColor="@color/solar_green_primary"
                    app:endIconMode="password_toggle"
                    app:errorIconDrawable="@null"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/solar_green_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_register_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Register Submit Button Container with Spinner -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_register"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Register Prosumer Account"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/btn_corner_radius"
                        app:backgroundTint="@color/solar_green_primary" />

                    <ProgressBar
                        android:id="@+id/pb_register"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="18dp"
                        android:elevation="6dp"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />
                </FrameLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Navigation Link to Login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_to_login"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Already have an account? Sign In"
            android:textAllCaps="false"
            android:textColor="@color/solar_green_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_register_form" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
