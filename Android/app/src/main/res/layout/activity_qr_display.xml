<?xml version="1.0" encoding="utf-8"?>
<!-- QR Display: toolbar and bottom nav stay fixed; the pass scrolls on short screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".prosumer.QRDisplayActivity">

    <LinearLayout
        android:id="@+id/header_bar_qr"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/solar_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_back_qr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tv_qr_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Microgrid Transaction Pass"
            android:textColor="@color/solar_slate_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_header_logout_qr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_logout"
            android:contentDescription="Log Out"
            android:src="@drawable/ic_logout"
            app:tint="@color/solar_status_cancelled" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/solar_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_qr_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_qr_instructions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Present this digital QR pass to the station operator upon arrival"
                android:textAlignment="center"
                android:textColor="@color/solar_slate_body"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_qr_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/solar_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_qr_instructions">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iv_qr_code"
                        android:layout_width="@dimen/qr_size"
                        android:layout_height="@dimen/qr_size"
                        android:adjustViewBounds="true"
                        android:contentDescription="Booking QR Code Pass"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_qr_reservation_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="Reservation #12345"
                android:textColor="@color/solar_green_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/card_qr_container" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/solar_border" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_qr"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/solar_surface"
        app:backgroundTint="@color/solar_surface"
        app:elevation="0dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemPaddingBottom="10dp"
        app:itemPaddingTop="10dp"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_prosumer" />

</LinearLayout>
