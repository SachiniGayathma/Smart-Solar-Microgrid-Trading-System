<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartSolarMobileApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/solar_green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/solar_green_container</item>
        <item name="colorOnPrimaryContainer">@color/solar_green_primary</item>
        <item name="colorSecondary">@color/solar_amber_primary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surfaces and Window Background -->
        <item name="android:windowBackground">@color/solar_bg</item>
        <item name="colorSurface">@color/solar_surface</item>
        <item name="colorOnSurface">@color/solar_slate_dark</item>

        <!-- Disable Material 3 surface tint overlay so surfaces stay pure white -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Status Bar Styling for Notch & Hole-Punch Clarity -->
        <item name="android:statusBarColor">@color/solar_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/solar_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Default TextInputLayout Styling -->
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>

        <!-- Bottom Navigation Styling -->
        <item name="bottomNavigationStyle">@style/SolarBottomNav</item>
    </style>

    <style name="Theme.SmartSolarMobileApp" parent="Base.Theme.SmartSolarMobileApp" />

    <!-- Bottom Navigation View Styling: Sleek, crisp white, with premium modern aesthetic -->
    <style name="SolarBottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/solar_surface</item>
        <item name="backgroundTint">@color/solar_surface</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/SolarBottomNavIndicator</item>
        <item name="itemTextAppearanceActive">@style/SolarBottomNavText.Active</item>
        <item name="itemTextAppearanceInactive">@style/SolarBottomNavText.Inactive</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="SolarBottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/solar_green_container</item>
        <item name="android:width">48dp</item>
        <item name="android:height">28dp</item>
    </style>

    <style name="SolarBottomNavText.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/solar_green_primary</item>
    </style>

    <style name="SolarBottomNavText.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/solar_slate_muted</item>
    </style>
</resources>