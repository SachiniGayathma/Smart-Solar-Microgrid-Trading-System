## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.userprefs
*.pidb
*.svclog
_ReSharper*/
*.[Cc]ache
*.ncb
*.sdf
*.opensdf
*.dbmdl

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# OS
.DS_Store
Thumbs.db

# Node (web client later)
node_modules/
dist/

# Android
*.apk
*.ap_
local.properties
.gradle/
**/build/
capture/
.externalNativeBuild/

# Secrets (keep local connection overrides out of git if added later)
appsettings.Local.json
*.pfx
ngrok.yml
